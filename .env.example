# .env

# Supabase Transaction Pooler URL (Port 6543) - Used for queries in production
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Supabase Direct URL (Port 5432) - Used for Prisma migrations
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# JWT Secret for Auth Cookies (Staff 12h / Admin 30d sessions)
# Any random secure string:
JWT_SECRET="super-secret-custom-key-change-this-in-production-12345"

# App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"